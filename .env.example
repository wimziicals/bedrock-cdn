# Copy this file to .env and fill it in. Bun loads .env automatically.

# Your Cloudflare account ID, shown under "Account Details" on the R2 Object Storage overview page
R2_ACCOUNT_ID=

# From an R2 API token with "Object Read & Write" permission on your bucket.
# Cloudflare only shows the secret once, when you create the token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET=

# The bucket's public address, without a trailing slash: its r2.dev URL or your custom domain
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Optional: any other S3-compatible storage (AWS S3, Backblaze B2, MinIO...). Replaces R2_ACCOUNT_ID.
# R2_ENDPOINT=https://s3.us-east-1.amazonaws.com
